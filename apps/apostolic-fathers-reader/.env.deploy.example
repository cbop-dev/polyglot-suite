# VPS Deployment Configuration for Apostolic Fathers Reader
# Copy this file to .env.deploy and configure your server credentials:
#   cp .env.deploy.example .env.deploy
#
# .env.deploy is ignored by git to keep your credentials secret.

VPS_USER=user
VPS_HOST=example.com
VPS_PORT=22
VPS_PATH=/home/johndoe/www/subs/fathers

# Optional URLs for convenience output:
# STAGING_URL=https://staging.fathers.example.com
# LIVE_URL=https://fathers.example.com
