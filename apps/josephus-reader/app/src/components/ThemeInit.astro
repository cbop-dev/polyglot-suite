---
// No-flash theme setup. Runs in <head> before paint so the page renders in the
// correct theme immediately.
import { generateThemeInitScript } from '@polyglot/theme';

const initScript = generateThemeInitScript({
  storageKey: 'ne-reading-theme',
  warmthStorageKey: 'ne-reading-warmth',
  legacyKey: 'ne-theme',
  profile: 'josephus'
});
---
<script is:inline set:html={initScript}></script>
