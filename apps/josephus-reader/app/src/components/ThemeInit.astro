---
// No-flash theme setup. Runs in <head> before paint so the page renders in the
// correct theme immediately.
---
<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('ne-theme');
      if (saved === 'dark' || saved === 'sepia' || saved === 'light') {
        document.documentElement.dataset.theme = saved;
      } else {
        document.documentElement.dataset.theme = 'light';
      }
    } catch (e) {}
  })();
</script>
