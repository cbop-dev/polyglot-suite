---
// Reading Theme & Warmth Control (Light vs. Dark & Cool vs. Warm)
import ThemeSlider from '@polyglot/theme/ThemeSlider.svelte';

interface Props {
  align?: 'left' | 'right';
}

const { align = 'right' } = Astro.props as Props;
---
<div class="theme-toggle-wrapper">
  <ThemeSlider
    client:load
    align={align}
    profile="josephus"
    storageKey="ne-reading-theme"
    warmthStorageKey="ne-reading-warmth"
    legacyKey="ne-theme"
  />
</div>

<style>
  .theme-toggle-wrapper {
    display: inline-flex;
    align-items: center;
  }
</style>
