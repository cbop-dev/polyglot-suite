{
  "name": "josephus-reader",
  "private": true,
  "version": "0.1.30",
  "repository": "https://github.com/cbop-dev/josephus-reader",
  "type": "module",
  "scripts": {
    "clean": "npm --prefix app run clean",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build:local",
    "build:app": "npm --prefix app run build:local",
    "build:all": "./scripts/run_pipeline.sh all && npm --prefix app run build:local",
    "build:www": "npm --prefix app run build:www",
    "build:www:app": "npm --prefix app run build:www",
    "build:www:all": "./scripts/run_pipeline.sh all && npm --prefix app run build:www",
    "build:vps": "npm run build:www",
    "build:vps:app": "npm run build:www:app",
    "build:vps:all": "npm run build:www:all",
    "preview": "npm --prefix app run preview",
    "preview:www": "npm --prefix app run preview:www",
    "preview:vps": "npm --prefix app run preview:www",
    "test": "npx -y tsx --test tests/*.test.ts",
    "check": "npm --prefix app run astro check",
    "pipeline": "./scripts/run_pipeline.sh all",
    "deploy:www": "./scripts/deploy_www.sh",
    "deploy:www:quick": "./scripts/deploy_www.sh --no-build",
    "deploy:www:promote": "./scripts/deploy_www.sh --promote",
    "deploy:promote": "npm run deploy:www:promote",
    "deploy:www:history": "./scripts/deploy_www.sh --history",
    "deploy:history": "npm run deploy:www:history",
    "deploy:www:clean": "./scripts/deploy_www.sh --clean",
    "rollback:www": "./scripts/deploy_www.sh --rollback",
    "rollback": "npm run rollback:www",
    "deploy:vps": "npm run deploy:www",
    "deploy:vps:quick": "npm run deploy:www:quick"
  }
}
