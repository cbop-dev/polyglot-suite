{
  "name": "ancient-corpora-reader",
  "private": true,
  "version": "0.4.0",
  "repository": "https://github.com/cbop-dev/polyglot-suite/tree/main/apps/ancient-corpora-reader",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "ADAPTER=node vite build",
    "build:www": "ADAPTER=static vite build",
    "build:static": "npm run build:www",
    "build:gh": "ADAPTER=github vite build",
    "build:github": "npm run build:gh",
    "preview": "npm run preview:www",
    "preview:www": "ADAPTER=static vite preview",
    "test": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "pipeline:build": "python3 -m pipeline.build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@polyglot/ancient-languages": "*",
    "@polyglot/db-vfs": "*",
    "@polyglot/lemma-ui": "*",
    "@polyglot/theme": "*",
    "@polyglot/ui": "*",
    "chart.js": "^4.5.1",
    "sql.js-httpvfs": "^0.8.12",
    "svelte-chartjs": "^4.0.1"
  }
}
