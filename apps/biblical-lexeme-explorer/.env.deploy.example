# VPS Deployment Configuration for LXX Vocab Web 2.0
# Copy this file to .env.deploy (or .env.production) and configure your server credentials:
#   cp .env.deploy.example .env.deploy
#
# .env.deploy is ignored by git to keep your credentials secret.

VPS_USER=your_username
VPS_HOST=your_server_ip_or_domain
VPS_PORT=22
VPS_PATH=/home/user/www/lex-vocab-web

# Optional URLs for convenience output:
# STAGING_URL=https://staging.lxx.example.com
# LIVE_URL=https://lxx.example.com
