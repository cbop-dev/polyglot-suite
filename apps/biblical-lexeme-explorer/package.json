{
  "name": "biblical-lexeme-explorer",
  "version": "2.3.0",
  "private": true,
  "repository": "https://github.com/cbop-dev/biblical-lexeme-explorer",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/apply-hebrew-errata.js",
    "prebuild:www": "node scripts/apply-hebrew-errata.js",
    "prebuild:node": "node scripts/apply-hebrew-errata.js",
    "dev": "vite dev",
    "build": "ADAPTER=node vite build",
    "build:node": "ADAPTER=node vite build",
    "build:www": "ADAPTER=static vite build",
    "build:static": "npm run build:www",
    "build:gh": "ADAPTER=github vite build",
    "build:github": "npm run build:gh",
    "preview": "ADAPTER=static vite preview",
    "preview:www": "ADAPTER=static vite preview",
    "preview:gh": "ADAPTER=github vite preview",
    "preview:github": "npm run preview:gh",
    "preview:node": "node build/node/index.js",
    "deploy:www": "./scripts/deploy_www.sh",
    "deploy:www:quick": "./scripts/deploy_www.sh --no-build",
    "deploy:www:promote": "./scripts/deploy_www.sh --promote",
    "deploy:promote": "npm run deploy:www:promote",
    "deploy:www:history": "./scripts/deploy_www.sh --history",
    "deploy:history": "npm run deploy:www:history",
    "deploy:www:clean": "./scripts/deploy_www.sh --clean",
    "rollback:www": "./scripts/deploy_www.sh --rollback",
    "rollback": "npm run rollback:www",
    "deploy:vps": "npm run deploy:www",
    "deploy:vps:quick": "npm run deploy:www:quick",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "utest": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic --project-token=chpt_22738bde68afc34",
    "pipeline": "python3 pipeline/run_pipeline.py",
    "pipeline:status": "python3 pipeline/run_pipeline.py --status",
    "pipeline:emit": "python3 pipeline/run_pipeline.py --emit",
    "pipeline:resolve": "python3 pipeline/run_pipeline.py --resolve",
    "pipeline:all": "python3 pipeline/run_pipeline.py --all",
    "pipeline:test-gi": "python3 -m pipeline.swete_morphology.gi_bridge"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.2",
    "@playwright/test": "^1.45.3",
    "@storybook/addon-essentials": "^8.4.4",
    "@storybook/addon-interactions": "^8.4.4",
    "@storybook/addon-svelte-csf": "^5.0.0-next.11",
    "@storybook/blocks": "^8.4.4",
    "@storybook/svelte": "^8.4.4",
    "@storybook/sveltekit": "^8.4.4",
    "@storybook/test": "^8.4.4",
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/better-sqlite3": "^7.6.11",
    "@types/eslint": "^9.6.0",
    "autoprefixer": "^10.4.20",
    "chromatic": "^11.18.1",
    "daisyui": "^5.7.50",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "mdsvex": "^0.11.2",
    "postcss": "^8.4.49",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "storybook": "^8.4.4",
    "svelte": "^5.0.0",
    "svelte-awesome-color-picker": "^4.1.0",
    "svelte-check": "^4.0.0",
    "svelte-range-slider-pips": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^5.4.19",
    "vitest": "^2.0.4"
  },
  "dependencies": {
    "@biblical-data/corpora": "*",
    "@inlang/paraglide-sveltekit": "^0.11.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@polyglot/ancient-languages": "*",
    "@polyglot/lemma-ui": "*",
    "@polyglot/theme": "*",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "chart.js": "^4.4.9",
    "colord": "^2.9.3",
    "d3-array": "^3.2.4",
    "d3-cloud": "^1.2.7",
    "debug": "^4.3.7",
    "gridjs": "^6.2.0",
    "gridjs-svelte": "^2.1.1",
    "pino": "^9.5.0",
    "svelte-d3-cloud": "^0.0.2",
    "wordcloud": "^1.2.3"
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "esbuild@0.21.5": true,
    "svelte-preprocess@5.1.4": true
  }
}
