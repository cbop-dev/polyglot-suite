{
  "name": "polyglot-suite",
  "version": "0.6.8",
  "private": true,
  "description": "Monorepo workspace for ancient language readers and linguistic toolkits",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:bible": "npm --workspace=polyglot-bible-reader run dev",
    "dev:lexeme": "npm --workspace=biblical-lexeme-explorer run dev",
    "dev:josephus": "npm --workspace=josephus-reader run dev",
    "dev:fathers": "npm --workspace=apostolic-fathers-reader run dev",
    "dev:philo": "npm --workspace=philo-reader run dev",
    "dev:corpora": "npm --workspace=ancient-corpora-reader run dev",
    "build:bible": "npm --workspace=polyglot-bible-reader run build",
    "build:lexeme": "npm --workspace=biblical-lexeme-explorer run build",
    "build:josephus": "npm --workspace=josephus-reader run build",
    "build:fathers": "npm --workspace=apostolic-fathers-reader run build",
    "build:philo": "npm --workspace=philo-reader run build",
    "build:corpora": "npm --workspace=ancient-corpora-reader run build",
    "fetch:db": "python3 packages/data-pipeline/fetcher.py --all",
    "fetch:bible": "npm run fetch:db",
    "build:db": "python3 packages/data-pipeline/build.py --build && python3 scripts/export_ble_manifests.py",
    "chunk:db": "python3 packages/data-pipeline/build.py --chunk",
    "chunk:bible": "npm run chunk:db",
    "data:all": "python3 packages/data-pipeline/build.py --all && python3 scripts/export_ble_manifests.py",
    "export:manifests": "python3 scripts/export_ble_manifests.py",
    "build:www": "npm run build:www:bible && npm run build:www:lexeme && npm run build:www:corpora && npm run build:www:portal",
    "build:gh": "node scripts/build_gh.js",
    "build:vps": "node scripts/build_vps.js",
    "preview:gh": "node scripts/preview.js",
    "preview:www": "node scripts/preview.js",
    "preview:corpora": "npm --workspace=ancient-corpora-reader run preview:www",
    "build:www:bible": "ADAPTER=static BASE_PATH=/bible BUILD_DIR=../../dist/bible npm --workspace=polyglot-bible-reader run build",
    "build:www:lexeme": "ADAPTER=static BASE_PATH=/lexemes BUILD_DIR=../../dist/lexemes npm --workspace=biblical-lexeme-explorer run build:www",
    "build:www:josephus": "ADAPTER=static BASE_PATH=/josephus BUILD_DIR=../../dist/josephus npm --workspace=josephus-reader run build",
    "build:www:fathers": "ADAPTER=static BASE_PATH=/fathers BUILD_DIR=../../dist/fathers npm --workspace=apostolic-fathers-reader run build",
    "build:www:philo": "ADAPTER=static BASE_PATH=/philo BUILD_DIR=../../dist/philo npm --workspace=philo-reader run build",
    "build:www:corpora": "ADAPTER=static BASE_PATH=/corpora BUILD_DIR=../../dist/corpora npm --workspace=ancient-corpora-reader run build",
    "build:www:portal": "node scripts/generate_portal.js",
    "deploy:portal": "./scripts/deploy_portal.sh",
    "deploy:portal:promote": "./scripts/deploy_portal.sh --promote",
    "dpp": "npm run deploy:portal:promote",
    "deploy:portal:rollback": "./scripts/deploy_portal.sh --rollback",
    "deploy:portal:history": "./scripts/deploy_portal.sh --history",
    "deploy:portal:clean": "./scripts/deploy_portal.sh --clean",
    "check:bible": "npm --workspace=polyglot-bible-reader run check",
    "check:lexeme": "npm --workspace=biblical-lexeme-explorer run check",
    "check:josephus": "npm --workspace=josephus-reader run check",
    "check:fathers": "npm --workspace=apostolic-fathers-reader run check",
    "check:philo": "npm --workspace=philo-reader run check",
    "check:corpora": "npm --workspace=ancient-corpora-reader run check",
    "test:bible": "npm --workspace=polyglot-bible-reader run test:unit -- --run",
    "test:lexeme": "npm --workspace=biblical-lexeme-explorer run test:unit -- --run",
    "test:josephus": "npm --workspace=josephus-reader run test",
    "test:corpora": "npm --workspace=ancient-corpora-reader test",
    "status:db:gh": "node scripts/status_db.js",
    "status:db": "node scripts/status_db.js",
    "pull:db": "node scripts/sync_db.js --pull",
    "pull:db:bible": "node scripts/sync_db.js --pull bible",
    "pull:db:philo": "node scripts/sync_db.js --pull philo",
    "pull:db:fathers": "node scripts/sync_db.js --pull fathers",
    "pull:db:josephus": "node scripts/sync_db.js --pull josephus",
    "pull:db:corpora": "node scripts/sync_db.js --pull corpora",
    "publish:db": "node scripts/sync_db.js --publish",
    "publish:db:bible": "node scripts/sync_db.js --publish bible",
    "publish:db:philo": "node scripts/sync_db.js --publish philo",
    "publish:db:fathers": "node scripts/sync_db.js --publish fathers",
    "publish:db:josephus": "node scripts/sync_db.js --publish josephus",
    "publish:db:corpora": "node scripts/sync_db.js --publish corpora",
    "push:db": "node scripts/sync_db.js --publish",
    "push:db:bible": "node scripts/sync_db.js --publish bible",
    "push:db:philo": "node scripts/sync_db.js --publish philo",
    "push:db:fathers": "node scripts/sync_db.js --publish fathers",
    "push:db:josephus": "node scripts/sync_db.js --publish josephus",
    "push:db:corpora": "node scripts/sync_db.js --publish corpora",
    "release:db": "node scripts/release_db.js",
    "release:db:bible": "node scripts/release_db.js bible",
    "release:db:philo": "node scripts/release_db.js philo",
    "release:db:fathers": "node scripts/release_db.js fathers",
    "release:db:josephus": "node scripts/release_db.js josephus",
    "release:db:corpora:af": "node scripts/release_db.js corpora-af",
    "release:db:corpora:philo": "node scripts/release_db.js corpora-philo",
    "release:db:corpora:josephus": "node scripts/release_db.js corpora-josephus",
    "version:bump": "node scripts/release.js bump",
    "version:tag": "node scripts/release.js tag",
    "release": "node scripts/release.js release"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  }
}
