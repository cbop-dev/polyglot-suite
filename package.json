{
  "name": "polyglot-suite",
  "version": "0.1.16",
  "private": true,
  "description": "Monorepo workspace for ancient language readers and linguistic toolkits",
  "workspaces": [
    "apps/*",
    "apps/josephus-reader/app",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:bible": "npm --workspace=polyglot-bible-reader run dev",
    "dev:josephus": "npm --workspace=josephus-reader run dev",
    "dev:fathers": "npm --workspace=apostolic-fathers-reader run dev",
    "dev:philo": "npm --workspace=philo-reader run dev",
    "build:bible": "npm --workspace=polyglot-bible-reader run build",
    "build:josephus": "npm --workspace=josephus-reader run build",
    "build:fathers": "npm --workspace=apostolic-fathers-reader run build",
    "build:philo": "npm --workspace=philo-reader run build",
    "build:www": "npm run build:www:bible && npm run build:www:josephus && npm run build:www:fathers && npm run build:www:philo && npm run build:www:portal",
    "build:www:bible": "ADAPTER=static BASE_PATH=/polyglot-suite/bible BUILD_DIR=../../dist/bible npm --workspace=polyglot-bible-reader run build",
    "build:www:josephus": "OUT_DIR=../../../dist/josephus BASE_PATH=/polyglot-suite/josephus npm --workspace=josephus-app run build",
    "build:www:fathers": "ADAPTER=static BASE_PATH=/polyglot-suite/fathers BUILD_DIR=../../dist/fathers npm --workspace=apostolic-fathers-reader run build",
    "build:www:philo": "ADAPTER=static BASE_PATH=/polyglot-suite/philo BUILD_DIR=../../dist/philo npm --workspace=philo-reader run build",
    "build:www:portal": "node scripts/generate_portal.js",
    "check:bible": "npm --workspace=polyglot-bible-reader run check",
    "check:josephus": "npm --workspace=josephus-reader run check",
    "check:fathers": "npm --workspace=apostolic-fathers-reader run check",
    "check:philo": "npm --workspace=philo-reader run check",
    "test:bible": "npm --workspace=polyglot-bible-reader run test",
    "test:josephus": "npm --workspace=josephus-reader run test",
    "pull:db": "node scripts/sync_db.js --pull",
    "pull:db:bible": "node scripts/sync_db.js --pull bible",
    "pull:db:philo": "node scripts/sync_db.js --pull philo",
    "pull:db:fathers": "node scripts/sync_db.js --pull fathers",
    "publish:db": "node scripts/sync_db.js --publish",
    "publish:db:bible": "node scripts/sync_db.js --publish bible",
    "publish:db:philo": "node scripts/sync_db.js --publish philo",
    "publish:db:fathers": "node scripts/sync_db.js --publish fathers",
    "version:bump": "node scripts/release.js bump",
    "version:tag": "node scripts/release.js tag",
    "release": "node scripts/release.js release"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  }
}
