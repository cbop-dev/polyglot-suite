{
  "name": "@polyglot/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified design system, UI controls, navigation widgets, charts, and icons for the Polyglot Suite",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./components/*": "./src/components/*",
    "./Button.svelte": "./src/components/controls/Button.svelte",
    "./OptionButton.svelte": "./src/components/controls/OptionButton.svelte",
    "./Modal2.svelte": "./src/components/controls/Modal2.svelte",
    "./CopyText.svelte": "./src/components/controls/CopyText.svelte",
    "./Tabs2.svelte": "./src/components/controls/Tabs2.svelte",
    "./Loading.svelte": "./src/components/controls/Loading.svelte",
    "./BarChart.svelte": "./src/components/charts/BarChart.svelte",
    "./PieChart.svelte": "./src/components/charts/PieChart.svelte",
    "./BubbleChart.svelte": "./src/components/charts/BubbleChart.svelte"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@polyglot/theme": "*",
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
