{
  "name": "@polyglot/lemma-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified lexical components, dictionary inspectors (LSJ, BDB, SEDRA), and frequency visualization charts for the Polyglot Suite",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./LSJEntry.svelte": "./src/components/LSJEntry.svelte",
    "./BDBEntry.svelte": "./src/components/BDBEntry.svelte",
    "./SEDRAEntry.svelte": "./src/components/SEDRAEntry.svelte",
    "./TextsDisplay.svelte": "./src/components/TextsDisplay.svelte",
    "./LemmaInfo.svelte": "./src/components/LemmaInfo.svelte",
    "./components/*": "./src/components/*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@polyglot/ancient-languages": "*",
    "@polyglot/theme": "*",
    "@polyglot/ui": "*",
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
