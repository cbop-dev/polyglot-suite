{
  "name": "@biblical-data/corpora",
  "version": "1.0.0",
  "description": "Standardized Biblical Corpora datasets, schemas, and isomorphic client readers for Septuagint (LXX), SBLGNT, and BHS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts"
    },
    "./schemas/*": "./schemas/*"
  },
  "keywords": [
    "septuagint",
    "lxx",
    "sblgnt",
    "bhs",
    "hebrew-bible",
    "greek-new-testament",
    "lsj-dictionary",
    "lexicon",
    "concordance",
    "biblical-data"
  ],
  "author": "C. Brannan",
  "license": "CC-BY-SA-4.0"
}
