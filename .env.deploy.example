# ==============================================================================
# Polyglot Suite Deployment Configuration Template
# Copy this file to .env.deploy and fill in your private server details:
#   cp .env.deploy.example .env.deploy
#
# NOTE: .env.deploy is ignored by git to protect your server hostnames and paths.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Base URLs for Cross-App Navigation
# Can be absolute URLs (https://sub.domain.com/path) or domain-root paths (/bible)
# ------------------------------------------------------------------------------
PUBLIC_BIBLE_APP_URL=https://bible.example.com
PUBLIC_LEXEMES_APP_URL=https://lexemes.example.com
PUBLIC_JOSEPHUS_APP_URL=https://josephus.example.com
PUBLIC_FATHERS_APP_URL=https://fathers.example.com
PUBLIC_PHILO_APP_URL=https://philo.example.com
PUBLIC_PORTAL_URL=https://example.com

# ------------------------------------------------------------------------------
# VPS SSH / Rsync Credentials (used by npm run deploy:portal)
# ------------------------------------------------------------------------------
VPS_USER=deploy_user
VPS_HOST=vps.example.com
VPS_PORT=22
VPS_PATH=/var/www/polyglot-suite

# Optional URLs for convenience output:
# PORTAL_STAGING_URL=https://staging.example.com
